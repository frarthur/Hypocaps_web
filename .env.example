# Supabase (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Algolia (recherche plein texte)
NEXT_PUBLIC_ALGOLIA_APP_ID=your-app-id
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=your-index-name
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=your-search-key
ALGOLIA_ADMIN_API_KEY=your-admin-key

# SMTP (emails transactionnels via contact form)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@hypocaps.fr
CONTACT_EMAIL=arthur.fresse@hypocaps.fr

# Netlify / Stackbit
STACKBIT_PREVIEW=false
URL=https://hypocaps.fr
